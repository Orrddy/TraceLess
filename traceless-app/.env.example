APP_NAME=TraceLess
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# ---------------------------------------------------------------
# Production / staging database (Neon Postgres)
# ---------------------------------------------------------------
# DB_CONNECTION=pgsql
# DB_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# DB_SSLMODE=require
# Neon: older libpq clients (e.g. PHP PDO) cannot send the SNI endpoint,
# so pass the compute endpoint ID explicitly. Use the "direct" host here,
# or omit this when your client supports SNI.
# DB_LIBPQ_OPTIONS=endpoint=ep-xxxxxxxxxxxx
#
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=traceless
# DB_USERNAME=postgres
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# ---------------------------------------------------------------
# Redis (Upstash or self-hosted). Use predis for Upstash TLS URLs.
# ---------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# When REDIS_URL is empty, you can connect with explicit TLS parameters.
# Useful when a local resolver cannot resolve the Upstash host:
# REDIS_SCHEME=tls
# REDIS_TLS_SERVER_NAME=your-database.upstash.io
# REDIS_USERNAME=default
# Set these once Redis is verified:
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# SESSION_CONNECTION=default
# REDIS_QUEUE_RETRY_AFTER=300

# Upstash REST credentials are only needed by non-Laravel clients.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------
# Mail: Resend in production, log locally.
# ---------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="alerts@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_MAILER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# MAIL_FROM_ADDRESS="alerts@your-verified-domain.com"

# Absent, request()->ip() is the direct peer address. Set to the proxy's IP or
# CIDR (comma separated), or * to trust the platform's forwarding headers.
# Required on any host that terminates TLS in front of the application.
TRUSTED_PROXIES=

# Passwordless email OTP (no account passwords are stored)
TRACELESS_DEMO_MODE=true
TRACELESS_OTP_EXPIRY_MINUTES=10
TRACELESS_OTP_MAX_ATTEMPTS=5
TRACELESS_OTP_RESEND_COOLDOWN=60
# Must be false in production: never render codes in the browser.
TRACELESS_OTP_DEMO_DISPLAY=true

# Breach metadata provider. Live scans skip credential checks while empty.
TRACELESS_BREACH_PROVIDER=

# IP exposure lookup: geo from ipinfo, abuse signal from AbuseIPDB.
TRACELESS_IP_ENDPOINT=https://ipinfo.io
# Optional ipinfo token, raises the rate limit.
TRACELESS_IP_TOKEN=
# Free tier key from https://www.abuseipdb.com/account/api. Empty disables the
# abuse half of the check.
TRACELESS_ABUSEIPDB_KEY=

# Python service boundary
TRACELESS_PYTHON_BINARY=python
TRACELESS_PYTHON_TIMEOUT=90
TRACELESS_MAX_FINDINGS=250
# Live scans check every monitored username; this bounds how many per scan.
TRACELESS_MAX_USERNAMES=5
# Absolute path to worker.py; defaults to ../python-services/scanner/worker.py
# TRACELESS_SCANNER_SCRIPT=/opt/traceless/python-services/scanner/worker.py

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
TRACELESS_DEEP_CATEGORIES=social,dev
DB_QUEUE_RETRY_AFTER=720