# Caddy config for one weeny.cloud release.
#
# `run.sh` exports APP_ROOT and PHP_SOCKET before calling this file, so the same
# config works for every release directory and for a local copy.
#
# weeny terminates TLS in front of the app, so this server speaks plain HTTP on
# :8080 only. Do not add automatic HTTPS here; the outer proxy owns certificates.

:8080 {
	root * {$APP_ROOT}/public

	encode gzip

	php_fastcgi unix/{$PHP_SOCKET} {
		# weeny terminates TLS in front of this server, so Caddy only ever sees
		# plain HTTP. Tell PHP the request was secure; otherwise Laravel builds
		# asset() URLs as http:// and the browser blocks them as mixed content.
		env HTTPS "on"
		env SERVER_PORT "443"

		# Slow boots on small instances; give the app room without hanging forever.
		read_timeout 120s
		write_timeout 120s
	}

	file_server

	# Health probe used by `weeny push --health`.
	handle /up {
		respond "ok" 200
	}

	header {
		-Server
	}

	log {
		output stderr
		format console
	}
}
