# TraceLess staging environment template.
# Copy to .env on the staging host and fill in real secrets.
# Never commit the filled file.

APP_NAME=TraceLess
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://staging.traceless.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --- Neon Postgres ---------------------------------------------------------
DB_CONNECTION=pgsql
DB_URL=postgresql://USER:PASSWORD@ep-xxxxxxxxxxxx-pooler.c-16.REGION.aws.neon.tech/neondb?sslmode=require
DB_SSLMODE=require
# Required when the PHP/libpq client cannot send the Neon SNI endpoint.
DB_LIBPQ_OPTIONS=endpoint=ep-xxxxxxxxxxxx

# Direct (unpooled) URL is used by migrations in some deployments.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxxxxxxxxxx.c-16.REGION.aws.neon.tech/neondb?sslmode=require

# --- Upstash Redis --------------------------------------------------------
REDIS_CLIENT=predis
REDIS_URL=rediss://default:PASSWORD@HOST:6379
REDIS_QUEUE_RETRY_AFTER=300
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=traceless
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

# --- Resend email ---------------------------------------------------------
MAIL_MAILER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM_ADDRESS=alerts@your-verified-domain.com
MAIL_FROM_NAME=TraceLess

# --- Application behaviour ------------------------------------------------
# Demo mode must stay off in staging/production.
TRACELESS_DEMO_MODE=false
TRACELESS_OTP_EXPIRY_MINUTES=10
TRACELESS_OTP_MAX_ATTEMPTS=5
TRACELESS_OTP_RESEND_COOLDOWN=60
# Never render codes in the browser outside local demo mode.
TRACELESS_OTP_DEMO_DISPLAY=false

TRACELESS_PYTHON_BINARY=python3
TRACELESS_PYTHON_TIMEOUT=90
TRACELESS_MAX_FINDINGS=250
TRACELESS_SCANNER_SCRIPT=/opt/traceless/python-services/scanner/worker.py
# Leave empty until a breach-metadata provider is configured.
TRACELESS_BREACH_PROVIDER=

# --- Realtime / broadcasting ---------------------------------------------
BROADCAST_CONNECTION=log

# --- Files (Cloudflare R2; S3 compatible) ---------------------------------
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Front-end ------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
