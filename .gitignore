# ---------------------------------------------------------------------------
# TraceLess — repository root
#
# The Laravel application keeps its own rules in traceless-app/.gitignore, and
# Laravel's storage/bootstrap directories ignore themselves via nested
# .gitignore files. This file only covers what lives above or outside the app.
# ---------------------------------------------------------------------------

# Secrets and environment files ---------------------------------------------
.env
.env.*
!.env.example
!.env.staging.example
.neon

# Operating-system and editor cruft -----------------------------------------
.DS_Store
Thumbs.db
*.swp
*~

# Video masters --------------------------------------------------------------
# These are byte-identical duplicates of the assets the application actually
# serves; tracking both would double ~15 MB of binaries.
# See traceless-app/public/assets/videos/.
/me.mp4
/bg neon.mp4

# Scratch scripts ------------------------------------------------------------
traceless-app/.tmp_ping.php

# Local secrets --------------------------------------------------------------
# Holds the deploy key used to push this repository. Never commit it.
/.secrets/

# Generated environment for the Altare app (contains production secrets).
traceless-app/deploy/altare.env

# Vendored third-party repositories -------------------------------------------
# Upstream clones are fetched, not tracked: each is a separate Git repository
# with its own history, and Git refuses to index files inside them.
#   python-services/upstream/WhatsMyName   (CC BY-SA 4.0 dataset)
#   python-services/upstream/user-scanner  (MIT, reference only)
# The scanner's runtime dataset is packaged under python-services/data/ so a
# fresh clone can run live scans without cloning anything.
python-services/upstream/
python-services/**/__pycache__/
python-services/**/*.pyc

# Local Python environment for the scanner service
python-services/.venv/

# Locally staged weeny release
.release/
# Local task brief containing real provider API keys (never commit).
/ip-intelligence.md
# Local commercial effect bundles and handoff artefacts
anti-slop/
HANDOFF.md
ROADMAP.txt
traceless-release.tar.gz
python-services/smtp_probe.php